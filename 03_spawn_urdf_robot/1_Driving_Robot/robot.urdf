<?xml version="1.0"?>
<robot name="diff_drive_robot">
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.3 0.2 0.1"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.3 0.2 0.1"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.5"/>
            <inertia ixx="0.00625" ixy="0.0" ixz="0.0" iyy="0.0125" iyz="0.0" izz="0.01625"/>
        </inertial>
    </link>
    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
            <mass value="0.05"/>
            <inertia ixx="0.0000329" ixy="0.0" ixz="0.0" iyy="0.0000625" iyz="0.0" izz="0.0000329"/>
        </inertial>
    </link>
    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
            <mass value="0.05"/>
            <inertia ixx="0.0000329" ixy="0.0" ixz="0.0" iyy="0.0000625" iyz="0.0" izz="0.0000329"/>
        </inertial>
    </link>
    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="0.02"/>
            <inertia ixx="0.0000072" ixy="0.0" ixz="0.0" iyy="0.0000072" iyz="0.0" izz="0.0000072"/>
        </inertial>
    </link>
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="0 0.12 0"/>
        <axis xyz="0 1 0"/>
    </joint>
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="0 -0.12 0"/>
        <axis xyz="0 1 0"/>
    </joint>
    <joint name="caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="-0.12 0 -0.06"/>
    </joint>

    <!-- REWRITE THEM -->
    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="left_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="right_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>/full/path/to/controllers.yaml</parameters>
        </plugin>
    </gazebo>
</robot>