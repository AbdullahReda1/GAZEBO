<?xml version="1.0"?>
<robot name="diff_drive_robot">
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.3 0.2 0.1"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.3 0.2 0.1"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.5"/>
            <inertia ixx="0.00625" ixy="0.0" ixz="0.0" iyy="0.0125" iyz="0.0" izz="0.01625"/>
        </inertial>
    </link>
    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
            <mass value="0.05"/>
            <inertia ixx="0.0000329" ixy="0.0" ixz="0.0" iyy="0.0000625" iyz="0.0" izz="0.0000329"/>
        </inertial>
    </link>
    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
            <mass value="0.05"/>
            <inertia ixx="0.0000329" ixy="0.0" ixz="0.0" iyy="0.0000625" iyz="0.0" izz="0.0000329"/>
        </inertial>
    </link>
    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="0.02"/>
            <inertia ixx="0.0000072" ixy="0.0" ixz="0.0" iyy="0.0000072" iyz="0.0" izz="0.0000072"/>
        </inertial>
    </link>
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.02 0.02 0.01"/>
            </geometry>
            <material name="green">
                <color rgba="0.1 0.6 0.2 1"/>
            </material>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.02 0.01"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="0.02"/>
            <inertia ixx="8.333e-7" ixy="0" ixz="0" iyy="8.333e-7" iyz="0" izz="1.333e-6"/>
        </inertial>
    </link>
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.06"/>
            </geometry>
            <material name="red">
                <color rgba="0.8 0.1 0.1 1"/>
            </material>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.06"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="0.02"/>
            <inertia ixx="1.050e-4" ixy="0" ixz="0" iyy="1.050e-4" iyz="0" izz="9.000e-5"/>
        </inertial>
    </link>
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.03 0.05 0.03"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.3 0.8 1"/>
            </material>
            <origin xyz="0.0 0.0 0.015" rpy="0.0 0.0 0.0"/>
        </visual>
        <visual>
            <origin xyz="0.02 0 0.015" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder radius="0.01" length="0.015"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.03 0.05 0.03"/>
            </geometry>
            <origin xyz="0.0 0.0 0.015" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.015" rpy="0.0 0.0 0.0"/>
            <mass value="0.05"/>
            <inertia ixx="1.417e-5" ixy="0" ixz="0" iyy="7.500e-6" iyz="0" izz="1.417e-5"/>
        </inertial>
    </link>
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_optical_frame"/>
        <origin xyz="0.02 0 0.015" rpy="-1.5708 0.0 -1.5708"/>
    </joint>
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="0 0.12 -0.02"/>
        <axis xyz="0 1 0"/>
    </joint>
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="0 -0.12 -0.02"/>
        <axis xyz="0 1 0"/>
    </joint>
    <joint name="caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="-0.12 0 -0.04"/>
    </joint>
    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0.0 0.0 0.055" rpy="0.0 0.0 0.0"/>
    </joint>
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="-0.05 0.0 0.08" rpy="0.0 0.0 0.0"/>
    </joint>
    <joint name="camera_pan_joint" type="revolute">
        <origin xyz="0.12 0.0 0.05" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-1.57" upper="1.57" effort="1.0" velocity="2.0"/>
        <dynamics damping="0.01" friction="0.0"/>
    </joint>
    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>
                gz_ros2_control/GazeboSimSystem
            </plugin>
        </hardware>
        <joint name="left_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="right_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="camera_pan_joint">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">
                    0.0
                </param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>
                /mnt/ubuntu_data/ROS2/GAZEBO/06_rviz2/controllers.yaml
            </parameters>
        </plugin>
    </gazebo>
    <gazebo reference="imu_joint">
        <preserveFixedJoint>
            true
        </preserveFixedJoint>
    </gazebo>
    <gazebo reference="lidar_joint">
        <preserveFixedJoint>
            true
        </preserveFixedJoint>
    </gazebo>
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <pose>
                0 0 0 0 0 0
            </pose>
            <always_on>
                true
            </always_on>
            <update_rate>
                100
            </update_rate>
            <topic>
                imu
            </topic>
            <gz_frame_id>
                imu_link
            </gz_frame_id>
        </sensor>
    </gazebo>
    <gazebo reference="lidar_link">
        <sensor name="lidar_sensor" type="gpu_lidar">
            <pose>
                0 0 0.02 0 0 0
            </pose>
            <always_on>
                true
            </always_on>
            <update_rate>
                10
            </update_rate>
            <topic>
                scan
            </topic>
            <gz_frame_id>
                lidar_link
            </gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>
                            360
                        </samples>
                        <min_angle>
                            -3.14159
                        </min_angle>
                        <max_angle>
                            3.14159
                        </max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>
                        0.1
                    </min>
                    <max>
                        10.0
                    </max>
                </range>
            </lidar>
        </sensor>
    </gazebo>
    <gazebo reference="camera_link">
            <sensor name="camera_sensor" type="camera">
                <pose>
                    0.02 0 0.015 0 0 0
                </pose>
                <always_on>
                    true
                </always_on>
                <update_rate>
                    30
                </update_rate>
                <topic>
                    camera
                </topic>
                <gz_frame_id>
                    camera_optical_frame
                </gz_frame_id>
                <camera>
                    <horizontal_fov>
                        1.047
                    </horizontal_fov>
                    <image>
                        <width>
                            640
                        </width>
                        <height>
                            480
                        </height>
                    </image>
                    <clip>
                        <near>
                            0.1
                        </near>
                        <far>
                            100
                        </far>
                    </clip>
                </camera>
            </sensor>
    </gazebo>
</robot>